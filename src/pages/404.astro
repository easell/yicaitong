---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="页面未找到｜易采通"
  description="您访问的页面不存在。"
  noindex={true}
>
  <section class="band" style="text-align:center;padding:100px 0">
    <div class="container">
      <h1 style="font-size:56px;margin:0 0 12px">404</h1>
      <p style="color:var(--muted)">您访问的页面不存在或已移动。</p>
      <p><a href="/" class="btn primary">返回首页</a></p>
    </div>
  </section>
</BaseLayout>
